# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files & caches
.gradle/
build/
**/build/

# Local configuration file (sdk path, api keys, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio / IntelliJ IDEA
*.iml
.idea/
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/runConfigurations/
.idea/shelf/
.idea/deploymentTargetSelector.xml

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# External native build folder
.externalNativeBuild/
.cxx/

# Kotlin compiler daemon and session logs
.kotlin/
.kotlin-daemon/

# Keystore files
*.jks
*.keystore

# OS-specific files
.DS_Store
Thumbs.db
Desktop.ini
